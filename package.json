  "description": "抖音爆款作品查询工具。根据关键词搜索抖音热门爆款作品，支持按日期范围筛选，支持按视频时长筛选，结果以结构化展示。当用户查找抖音热门内容、搜索抖音爆款视频、查询抖音作品数据时使用。触发词：抖音爆款、抖音热门、抖音热榜、抖音作品查询、抖音搜索、爆款视频、热门视频。",
  "keywords": [
    "douyin",
    "search",
    "hot",
    "keyword",
    "content-analysis",
    "competitor-analysis"
  ],
  "author": "um-why",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=16.14.0"
  },
  "scripts": {
    "search": "node src/douyin/search-cli.js",
    "post": "node src/douyin/post-cli.js",
    "comment": "node src/douyin/comment-cli.js",
    "hot": "node src/douyin/hot-cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/um-why/douyin-search-openclaw.git"
  }
